generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Vendor {
  id           String   @id @default(uuid())
  externalRef  String   @unique @map("external_ref")
  name         String
  status       String   @default("active")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  campaigns         Campaign[]
  trafficEvents     TrafficEvent[]
  sessions          Session[]
  vendorScores      VendorScore[]
  recommendations   Recommendation[]
  alerts            Alert[]
}

model Campaign {
  id          String   @id @default(uuid())
  vendorId    String   @map("vendor_id")
  externalRef String   @map("external_ref")
  name        String
  status      String   @default("active")
  vertical    String   @default("automotive")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  vendor        Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  trafficEvents TrafficEvent[]
  sessions      Session[]

  @@unique([vendorId, externalRef])
  @@index([vendorId])
}

model TrafficEvent {
  id                BigInt   @id @default(autoincrement())
  eventId           String   @unique @map("event_id")
  occurredAt        DateTime @map("occurred_at")
  receivedAt        DateTime @default(now()) @map("received_at")
  eventType         String   @map("event_type")
  vendorId          String?  @map("vendor_id")
  campaignId        String?  @map("campaign_id")
  sessionKey        String?  @map("session_key")
  subjectId         String?  @map("subject_id")
  experimentRunId   String?  @map("experiment_run_id")
  armCode           String?  @map("arm_code")
  costCents         BigInt?  @map("cost_cents")
  currency          String   @default("USD")
  geoCountry        String?  @map("geo_country")
  geoRegion         String?  @map("geo_region")
  deviceClass       String?  @map("device_class")
  userAgent         String?  @map("user_agent")
  ipSubnet          String?  @map("ip_subnet")
  redirectStatus    Int?     @map("redirect_status")
  payload           Json?
  ingestVersion     Int      @default(1) @map("ingest_version")

  vendor          Vendor?         @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  campaign        Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  experimentRun   ExperimentRun?  @relation(fields: [experimentRunId], references: [id], onDelete: SetNull)

  @@index([occurredAt])
  @@index([sessionKey, occurredAt])
  @@index([vendorId, occurredAt])
  @@index([campaignId, occurredAt])
  @@index([experimentRunId])
  @@map("traffic_events")
}

model Session {
  id               String    @id @default(uuid())
  sessionKey       String    @map("session_key")
  subjectId        String?   @map("subject_id")
  vendorId         String    @map("vendor_id")
  campaignId       String    @map("campaign_id")
  startedAt        DateTime  @map("started_at")
  endedAt          DateTime? @map("ended_at")
  engaged          Boolean   @default(false)
  engagementScore  Float?    @map("engagement_score")
  totalCostCents   BigInt    @default(0) @map("total_cost_cents")
  geoCountry       String?   @map("geo_country")
  deviceClass      String?   @map("device_class")
  experimentRunId  String?   @map("experiment_run_id")
  armCode          String?   @map("arm_code")
  stratumKey       String    @map("stratum_key")
  closedAt         DateTime? @map("closed_at")
  derivedVersion   Int       @default(1) @map("derived_version")

  vendor        Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  campaign      Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  experimentRun ExperimentRun? @relation(fields: [experimentRunId], references: [id], onDelete: SetNull)

  @@index([vendorId, startedAt])
  @@index([campaignId, startedAt])
  @@index([stratumKey, startedAt])
  @@index([experimentRunId])
  @@unique([sessionKey])
  @@map("sessions")
}

model ExperimentRun {
  id                    String    @id @default(uuid())
  experimentKey         String    @map("experiment_key")
  version               Int       @default(1)
  campaignId            String?   @map("campaign_id")
  title                 String
  status                String    @default("draft")
  startsAt              DateTime  @map("starts_at")
  endsAt                DateTime  @map("ends_at")
  eligibility           Json?
  arms                  Json
  maxDivertedFraction   Float     @map("max_diverted_fraction")
  maxSpendCentsPerDay   BigInt?   @map("max_spend_cents_per_day")
  assignmentSalt        String    @map("assignment_salt")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  assignments       ExperimentAssignment[]
  trafficEvents     TrafficEvent[]
  sessions          Session[]
  recommendations   Recommendation[]
  alerts            Alert[]

  @@unique([experimentKey, version])
  @@index([status, startsAt])
  @@map("experiment_runs")
}

model ExperimentAssignment {
  id               BigInt   @id @default(autoincrement())
  experimentRunId  String   @map("experiment_run_id")
  subjectId        String   @map("subject_id")
  armCode          String   @map("arm_code")
  assignedAt       DateTime @default(now()) @map("assigned_at")
  stratumKey       String?  @map("stratum_key")

  experimentRun ExperimentRun @relation(fields: [experimentRunId], references: [id], onDelete: Cascade)

  @@unique([experimentRunId, subjectId])
  @@index([experimentRunId, armCode])
  @@map("experiment_assignments")
}

model VendorScore {
  id                  BigInt   @id @default(autoincrement())
  vendorId            String   @map("vendor_id")
  campaignId          String?  @map("campaign_id")
  stratumKey          String   @map("stratum_key")
  windowStart         DateTime @map("window_start") @db.Date
  windowEnd           DateTime @map("window_end") @db.Date
  windowType          String   @map("window_type")
  metricVersion       String   @map("metric_version")
  qRaw                Float    @map("q_raw")
  qDisplay            Float    @map("q_display")
  erShrunk            Float    @map("er_shrunk")
  cpe                 Float?
  anoRisk             Float    @map("ano_risk")
  confidence          Float
  sessions            Int
  engagedSessions     Int      @map("engaged_sessions")
  tier                String
  percentileInStratum Float?   @map("percentile_in_stratum")
  computedAt          DateTime @default(now()) @map("computed_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, windowEnd])
  @@index([stratumKey, windowEnd])
  @@map("vendor_scores")
}

model Recommendation {
  id                 String    @id @default(uuid())
  vendorId           String    @map("vendor_id")
  campaignId         String?   @map("campaign_id")
  action             String
  reasonCodes        String[]  @map("reason_codes")
  confidence         String
  supportingScoreId  BigInt?   @map("supporting_score_id")
  experimentRunId    String?   @map("experiment_run_id")
  validFrom          DateTime  @default(now()) @map("valid_from")
  validTo            DateTime? @map("valid_to")
  supersededBy       String?   @map("superseded_by")
  ruleVersion        String    @map("rule_version")
  detail             Json?
  createdAt          DateTime  @default(now()) @map("created_at")

  vendor        Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  experimentRun ExperimentRun? @relation(fields: [experimentRunId], references: [id], onDelete: SetNull)

  @@index([vendorId])
  @@index([createdAt])
  @@map("recommendations")
}

model Alert {
  id                String    @id @default(uuid())
  alertType         String    @map("alert_type")
  severity          String
  vendorId          String?   @map("vendor_id")
  campaignId        String?   @map("campaign_id")
  experimentRunId   String?   @map("experiment_run_id")
  title             String
  detail            Json?
  firedAt           DateTime  @default(now()) @map("fired_at")
  acknowledgedAt    DateTime? @map("acknowledged_at")
  status            String    @default("open")

  vendor        Vendor?        @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  experimentRun ExperimentRun? @relation(fields: [experimentRunId], references: [id], onDelete: SetNull)

  @@index([status, firedAt])
  @@index([vendorId])
  @@map("alerts")
}
